# Keboola (in the Data App these come from the platform / app secrets - never commit real values)
KBC_URL=https://connection.europe-west3.gcp.keboola.com
KBC_TOKEN=

# Writeback bucket for app-owned tables (must be created before first use, see docs/ARCHITECTURE.md)
APP_BUCKET=in.c-3mfc-app

# Snowflake database of project 810 used for Query Service reads
STAGING_DB=KBC_EUW3_810
BUCKET_WEEKLY=out.c-3MFC-Weekly-Cash-Flow-Facts--App-Prefill-staging
BUCKET_BOOTSTRAP=out.c-3MFC-App-Backend-Bootstrap-no-writes
BUCKET_FX=out.c-3MFC-VIT-Entity-Dictionary--Prior-Month-FX-staging

# Comma-separated e-mails that get ADMIN before DIM_3MFC_APP_USER_ACCESS is filled
APP_BOOTSTRAP_ADMINS=

# Public URL of the deployed app (used in notification e-mails)
APP_PUBLIC_URL=

# LOCAL DEVELOPMENT ONLY - bypasses the auth proxy. Never set in the Data App.
APP_DEV_USER=
APP_DEV_ROLE=HQ
